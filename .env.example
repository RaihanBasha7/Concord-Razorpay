# ── Backend (Render) ──────────────────────────────────────────────
# Groq API key for Layer 2 LLM inference scripts (run locally).
# The deployed API never calls the LLM — it replays frozen artifacts —
# so this is optional at runtime. Never commit a real key.
GROQ_API_KEY=

# CORS — comma-separated list of origins allowed to call the API,
# or "*" for development. When unset the backend defaults to "*".
# Leave the variable set to an empty string to block cross-origin
# browser requests (safe default).
# Example:
# CONCORD_CORS_ORIGINS=https://concord-demo.vercel.app

# ── Frontend (Vercel) ─────────────────────────────────────────────
# Production API base URL. Set this in the Vercel project settings
# (Settings → Environment Variables → VITE_API_BASE_URL). The local
# development fallback is http://127.0.0.1:8000 in concord.ts.
# Example:
# VITE_API_BASE_URL=https://concord-api.onrender.com
